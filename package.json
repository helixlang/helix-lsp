{
    "name": "helix-language",
    "displayName": "helix-language",
    "description": "Minimal language support and syntax highlighting for Helix.",
    "readme": "README.md",
    "icon": "public/icons/helix-v3.ico",
    "repository": {
        "type": "git",
        "url": "https://github.com/helixlang/helix-lsp"
    },
    "version": "0.2.6",
    "publisher": "helix-lang",
    "engines": {
        "vscode": "^1.94.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:helix",
        "onCommand:helix.restartLSP"
    ],
    "main": "dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "helix",
                "configuration": "public/language-configuration.json",
                "aliases": [
                    "helix",
                    "Helix",
                    "hlx"
                ],
                "extensions": [
                    ".hlx",
                    ".helix",
                    
                    ".hdx",
                    ".hdlx",
                    ".helixh"
                ],
                "icon": {
                    "light": "public/icons/file-helix-v3.svg",
                    "dark": "public/icons/file-helix-v3.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "helix",
                "scopeName": "source.helix",
                "path": "public/syntaxes/helix.tmLanguage.json"
            }
        ],
        "configuration": {
            "properties": {
                "helix.path": {
                    "type": "string",
                    "default": "helix",
                    "description": "Path to the Helix executable"
                },

                "helix.pythonPath": {
                    "type": "string",
                    "default": "python",
                    "description": "Path to the Python executable"
                },
                "helix.serverPath": {
                    "type": "string",
                    "default": "helix-lsp",
                    "description": "Path to the Helix Language Server executable"
                }
            }
        },
        "commands": [
            {
                "command": "helix.restartLSP",
                "title": "helix: Restart Language Server"
            }
        ],
         "breakpoints": [
            {
                "language": "helix"
            }
        ],
        "debuggers": [
            {
                "type": "cppvsdbg",
                "label": "C++ (MSVC) Debugger (Helix)",
                "languages": ["helix"]
            },
            {
                "type": "cppdbg",
                "label": "C++ (GDB/LLDB) Debugger (Helix)",
                "languages": ["helix"]
            }
        ]
    },
    "scripts": {
        "lint": "eslint src --ext ts",
        "start": "node dist/extension.js",
        "build": "npx tsc"
    },
    "devDependencies": {
        "@types/node": "^20.5.7",
        "@types/vscode": "^1.94.0",
        "eslint": "^8.28.0",
        "mocha": "^10.1.0",
        "nodemon": "^2.0.20",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "vscode-languageclient": "^8.1.0",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-protocol": "^3.17.5"
    }
}



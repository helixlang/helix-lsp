{
    "name": "kairo",
    "displayName": "Kairo Language Support",
    "description": "Minimal language support and syntax highlighting for Kairo.",
    "readme": "README.md",
    "icon": "public/icons/kairo-v3.ico",
    "repository": {
        "type": "git",
        "url": "https://github.com/kairolang/kairo-lsp"
    },
    "version": "0.5.4",
    "publisher": "KSF",
    "engines": {
        "vscode": "^1.94.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:kairo",
        "onCommand:kairo.restartLSP"
    ],
    "main": "dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "kairo",
                "configuration": "public/language-configuration.json",
                "aliases": [
                    "kairo",
                    "Kairo",
                    "kro"
                ],
                "extensions": [
                    ".hlx",
                    ".helix",
                    ".hdx",
                    ".hdlx",
                    ".kairo",
                    ".kro",
                    ".kh",
                    ".kairoh"
                ],
                "icon": {
                    "light": "public/icons/file-kairo-v3.svg",
                    "dark": "public/icons/file-kairo-v3.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "kairo",
                "scopeName": "source.kairo",
                "path": "public/syntaxes/kairo.tmLanguage.json"
            }
        ],
        "configuration": {
            "properties": {
                "kairo.path": {
                    "type": "string",
                    "default": "kairo",
                    "description": "Path to the Kairo compiler. Leave as 'kairo' to auto-detect from PATH."
                },
                "kairo.pythonPath": {
                    "type": "string",
                    "default": "python",
                    "description": "Path to Python 3. Leave as 'python' to auto-detect from PATH."
                },
                "kairo.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to lsp-server.py. Leave empty to derive from compiler location."
                }
            }
        },
        "commands": [
            {
                "command": "kairo.restartLSP",
                "title": "kairo: Restart Language Server"
            },
            {
                "command": "kairo.showIR",
                "title": "Kairo: Show IR"
            }
        ],
        "breakpoints": [
            {
                "language": "kairo"
            }
        ],
        "debuggers": [
            {
                "type": "cppvsdbg",
                "label": "C++ (MSVC) Debugger (Kairo)",
                "languages": [
                    "kairo"
                ]
            },
            {
                "type": "cppdbg",
                "label": "C++ (GDB/LLDB) Debugger (Kairo)",
                "languages": [
                    "kairo"
                ]
            }
        ],
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": "string.quoted.double.raw.kairo",
                        "settings": {
                            "foreground": "#f26d78"
                        }
                    }
                ]
            }
        }
    },
    "scripts": {
        "lint": "eslint src --ext ts",
        "start": "node dist/extension.js",
        "build": "npx tsc"
    },
    "devDependencies": {
        "@types/node": "^20.5.7",
        "@types/vscode": "^1.94.0",
        "eslint": "^8.28.0",
        "mocha": "^10.1.0",
        "nodemon": "^2.0.20",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "vsce": "^2.15.0",
        "vscode-languageclient": "^8.1.0",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-protocol": "^3.17.5"
    }
}

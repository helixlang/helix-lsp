{
    "version": "0.2.2",
    "scopeName": "source.kairo",
    "name": "kairo",
    "patterns": [
        {
            "include": "#block-comments"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#class_reference"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#types"
        },
        {
            "include": "#define"
        },
        {
            "include": "#namespaces"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#generics"
        }
    ],
    "repository": {
        "expressions": {
            "patterns": [
                {
                    "include": "#class_reference"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#functions"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#define"
                },
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#punctuation"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#variables"
                },
                {
                    "include": "#generics"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.doxygen",
                    "match": "///.*$",
                    "captures": {
                        "0": { "name": "comment.line.doxygen" }
                    },
                    "patterns": [
                        {
                            "name": "keyword.other.doxygen",
                            "match": "\\\\(param|return|brief|note|warning|see|throws|exception|retval|sa|ingroup|author|date|version)\\b"
                        }
                    ]
                },
                {
                    "name": "comment.line.kairo",
                    "match": "//.*$",
                    "captures": {
                        "0": { "name": "comment.line.kairo" }
                    },
                    "patterns": [
                        {
                            "name": "invalid.illegal.doxygen",
                            "match": "\\\\(param|return|brief|note|warning|see|throws|exception|retval|sa|ingroup|author|date|version)\\b"
                        }
                    ]
                }
            ]
        },
        "block-comments": {
            "patterns": [
                {
                    "comment": "block comments",
                    "name": "comment.block.kairo",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.numeric.decimal.kairo",
                    "match": "\\b\\d[\\d_]*(\\.?)[\\d_]*(?:(E|e)([+-]?)([\\d_]+))?\\b"
                },
                {
                    "name": "constant.numeric.hex.kairo",
                    "match": "\\b0x[\\da-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.oct.kairo",
                    "match": "\\b0o[0-7_]+\\b"
                },
                {
                    "name": "constant.numeric.bin.kairo",
                    "match": "\\b0b[01_]+\\b"
                },
                {
                    "name": "constant.language.bool.kairo",
                    "match": "\\b(true|false|null|nullptr)\\b"
                }
            ]
        },
        "escapes": {
            "comment": "escapes: ASCII, byte, Unicode, quote, regex",
            "name": "constant.character.escape.kairo",
            "match": "(\\\\)(?:(?:(x[0-7][\\da-fA-F])|(u(\\{)[\\da-fA-F]{4,6}(\\}))|.))",
            "captures": {
                "1": {
                    "name": "constant.character.escape.backslash.kairo"
                },
                "2": {
                    "name": "constant.character.escape.bit.kairo"
                },
                "3": {
                    "name": "constant.character.escape.unicode.kairo"
                },
                "4": {
                    "name": "constant.character.escape.unicode.punctuation.kairo"
                },
                "5": {
                    "name": "constant.character.escape.unicode.punctuation.kairo"
                }
            }
        },
        "functions": {
            "patterns": [
                {
                    "comment": "function definition",
                    "name": "meta.function.definition.kairo",
                    "begin": "\\b(fn)\\s+(((?!self|super))?[A-Za-z0-9_]+)((\\()|(<))",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.fn.kairo"
                        },
                        "2": {
                            "name": "entity.name.function.kairo"
                        },
                        "4": {
                            "name": "punctuation.brackets.round.kairo"
                        },
                        "5": {
                            "name": "punctuation.brackets.angle.kairo"
                        }
                    },
                    "end": "\\{|;",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.brackets.curly.kairo"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#block-comments"
                        },
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "#keywords"
                        },
                        {
                            "include": "#class_reference"
                        },
                        {
                            "include": "#constants"
                        },
                        {
                            "include": "#functions"
                        },
                        {
                            "include": "#define"
                        },
                        {
                            "include": "#namespaces"
                        },
                        {
                            "include": "#punctuation"
                        },
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "include": "#variables"
                        }
                    ]
                },
                {
                    "comment": "function/method calls, chaining, and generic function calls, including generics before the parenthesis",
                    "name": "meta.function.call.kairo",
                    "begin": "(((?!self|super))?[A-Za-z0-9_]+)((<([A-Za-z0-9_]+(::[A-Za-z0-9_]+)*(,\\s*[A-Za-z0-9_]+(::[A-Za-z0-9_]+)*)*)>)?)(\\()",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.function.kairo"
                        },
                        "4": {
                            "name": "storage.type.generic.kairo"
                        },
                        "5": {
                            "name": "entity.name.type.kairo"
                        },
                        "9": {
                            "name": "punctuation.brackets.round.kairo"
                        }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.brackets.round.kairo"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#block-comments"
                        },
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "#attributes"
                        },
                        {
                            "include": "#keywords"
                        },
                        {
                            "include": "#class_reference"
                        },
                        {
                            "include": "#constants"
                        },
                        {
                            "include": "#functions"
                        },
                        {
                            "include": "#define"
                        },
                        {
                            "include": "#namespaces"
                        },
                        {
                            "include": "#punctuation"
                        },
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "include": "#variables"
                        },
                        {
                            "include": "#generics"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "Control flow keywords",
                    "name": "keyword.control.kairo",
                    "match": "\\b(break|case|continue|default|else|for|if|match|switch|unless|in|while)\\b"
                },
                {
                    "comment": "Function and method keywords",
                    "name": "keyword.function.kairo",
                    "match": "\\b(override|virtual|fn|inline|macro|op|return|yield)\\b"
                },
                {
                    "comment": "Class and struct keywords",
                    "name": "keyword.class.kairo",
                    "match": "\\b(class|enum|struct|type)\\b"
                },
                {
                    "comment": "Inheritance and polymorphism keywords",
                    "name": "keyword.inheritance.kairo",
                    "match": "\\b(extend|derives|where|interface|requires|impl)\\b"
                },
                {
                    "comment": "Error handling keywords",
                    "name": "keyword.error.kairo",
                    "match": "\\b(catch|finally|panic|try|test|assert)\\b"
                },
                {
                    "comment": "Variable declaration keywords",
                    "name": "keyword.declaration.kairo",
                    "match": "\\b(eval|var|static|const)\\b"
                },
                {
                    "comment": "Access specifiers",
                    "name": "keyword.access.kairo",
                    "match": "\\b(module|priv|pub|prot)\\b"
                },
                {
                    "comment": "Module importing keywords",
                    "name": "keyword.import.kairo",
                    "match": "\\b(ffi|import)\\b"
                },
                {
                    "comment": "Concurrency keywords",
                    "name": "keyword.concurrency.kairo",
                    "match": "\\b(await|async|thread)\\b"
                },
                {
                    "comment": "Other keywords",
                    "name": "keyword.other.kairo",
                    "match": "\\b(sizeof|alignof|typeof|as|delete|unsafe)\\b"
                },
                {
                    "comment": "Primitive Type keywords",
                    "name": "keyword.primitive.kairo",
                    "match": "\\b(f32|f64|f80|i256|f128|i128|i16|i32|i64|i8|isize|u128|u256|u16|u32|u64|u8|usize|char|bool|void)\\b"
                },
                {
                    "comment": "Operators",
                    "name": "keyword.operator.kairo",
                    "match": "\\b(\\+|\\+\\+|\\+=|\\+-|\\-|\\-\\-|\\-=|\\*|\\*=|\\/|\\/=|%|%=|&|&=|&&|&&=|@|@=|\\^|\\^=|^^|^^=|~|~&|~&=|~\\||~\\|=|\\||\\|=|\\|\\||\\|\\|=|!|!=|!&|!&=|!\\||!\\|=|<<|<<=|>>|>>=|==|===|>|>=|<|<=|\\.\\.|\\.\\.=|::|->|=|\\*\\*|\\*\\*=)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "comment": "numeric types",
                    "match": "\\b(int|float|decimal)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.numeric.kairo"
                        }
                    }
                },
                {
                    "comment": "complex types",
                    "match": "\\b(string|list|map|set|tuple)\\b",
                    "name": "entity.name.type.complex.kairo"
                },
                {
                    "comment": "user-defined types, possibly with generics",
                    "match": "\\b(class|struct|enum|union|type)\\s+([A-Z][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.type.kairo"
                        },
                        "2": {
                            "name": "entity.name.type.user-defined.kairo"
                        }
                    }
                },
                {
                    "comment": "type parameters",
                    "match": "\\b([A-Z][A-Za-z0-9_]*)\\b",
                    "name": "entity.name.type.parameter.kairo"
                }
            ]
        },
        "generics": {
            "patterns": [
                {
                    "comment": "generic type parameters",
                    "name": "storage.type.generic.kairo",
                    "begin": "<",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.generic.begin.kairo"
                        }
                    },
                    "end": ">",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.generic.end.kairo"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#namespaces"
                        },
                        {
                            "include": "#punctuation"
                        }
                    ]
                }
            ]
        },
        "loops": {
            "patterns": [
                {
                    "comment": "Standard for loop",
                    "name": "meta.loop.for.kairo",
                    "begin": "\\b(for)\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*;",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.loop.for.kairo"
                        },
                        "2": {
                            "name": "storage.type.variable.kairo"
                        }
                    },
                    "end": "\\{",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.parenthesis.kairo"
                        }
                    },
                    "patterns": []
                }
            ]
        },
        "define": {
            "patterns": [
                {
                    "comment": "Define invocation with optional parameters",
                    "name": "meta.define.invocation.kairo",
                    "match": "\\s?([a-z_][A-Za-z0-9_]+!)",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.define.kairo"
                        }
                    }
                },
                {
                    "comment": "Define macro with optional parameter list and complex body",
                    "name": "meta.define.macro.kairo",
                    "begin": "\\b(macro)\\s+([a-z0-9_]+[A-Za-z0-9_]*!)(\\s*\\()?",
                    "end": "\\)\\s*->\\s*([a-z0-9_]+)\\s*\\{",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.define.kairo"
                        },
                        "2": {
                            "name": "entity.name.function.define.kairo"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.kairo"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.parameters.end.kairo"
                        },
                        "2": {
                            "name": "punctuation.definition.body.begin.kairo"
                        }
                    }
                },
                {
                    "comment": "Proc macro",
                    "name": "meta.procedure.macro.kairo",
                    "begin": "\\b(macro)\\s+([a-z0-9_]+[A-Za-z0-9_]*)(\\()",
                    "end": "\\)\\s*->\\s*([a-z0-9_]+)\\s*\\{",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.macro.kairo"
                        },
                        "2": {
                            "name": "entity.name.function.macro.kairo"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.kairo"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.parameters.end.kairo"
                        },
                        "1": {
                            "name": "entity.name.type.return.kairo"
                        },
                        "2": {
                            "name": "punctuation.definition.body.begin.kairo"
                        }
                    }
                }
            ]
        },
        "namespaces": {
            "patterns": [
                {
                    "comment": "namespace (non-type, non-function path segment)",
                    "name": "entity.other.namespace.kairo",
                    "match": "(?<![A-Za-z0-9_])([A-Za-z0-9_]+)(::)",
                    "captures": {
                        "1": {
                            "name": "entity.name.namespace.kairo"
                        },
                        "2": {
                            "name": "keyword.operator.namespace.kairo"
                        }
                    }
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.comma.kairo",
                    "match": ","
                },
                {
                    "name": "punctuation.brackets.curly.kairo",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.brackets.round.kairo",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.semi.kairo",
                    "match": ";"
                },
                {
                    "name": "punctuation.brackets.square.kairo",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.brackets.angle.kairo",
                    "match": "(?<!=)[<>]"
                }
            ]
        },
        "fstring-formatting-braces": {
            "patterns": [
                {
                    "comment": "f-string formatting braces",
                    "name": "punctuation.section.embedded.kairo",
                    "begin": "\\{",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.begin.kairo"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.end.kairo"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
		},
        "f-strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.kairo",
                    "begin": "(\\b[fFrRuUbB])([bBuU])?((['\"]))",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.f-string.kairo"
                        },
                        "2": {
                            "name": "keyword.other.f-string.kairo"
                        },
                        "3": {
                            "name": "punctuation.definition.string.kairo"
                        }
                    },
                    "end": "(\\3)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.kairo"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#fstring-formatting-braces"
                        },
                        {
                            "include": "#escapes"
                        },
                        {
                            "include": "#interpolations"
                        }
                    ]
                }
                
            ]
        },
        "strings": {
            "patterns": [
                {
                    "include": "#f-strings"
                },
                {
                    "comment": "double-quoted strings and byte strings",
                    "name": "string.quoted.double.kairo",
                    "begin": "(\")",
                    "beginCaptures": {
                        "1": {
                            "name": "string.quoted.byte.raw.kairo"
                        },
                        "2": {
                            "name": "punctuation.definition.string.kairo"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.kairo"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#escapes"
                        },
                        {
                            "include": "#interpolations"
                        }
                    ]
                },
                {
                    "comment": "characters and bytes",
                    "name": "string.quoted.single.char.kairo",
                    "begin": "(')",
                    "beginCaptures": {
                        "1": {
                            "name": "string.quoted.byte.raw.kairo"
                        },
                        "2": {
                            "name": "punctuation.definition.char.kairo"
                        }
                    },
                    "end": "'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.char.kairo"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#escapes"
                        }
                    ]
                }
            ]
        },
        "class_reference": {
            "patterns": [
                {
                    "comment": "self",
                    "name": "variable.language.self.kairo",
                    "match": "\\bself\\b"
                },
                {
                    "comment": "super",
                    "name": "variable.language.super.kairo",
                    "match": "\\bsuper\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.kairo",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}